            "state": "translated",
            "value": "Farm Together 2 verwendet Spielstandversion %@. Die benötigten Daten konnten nicht sicher gelesen werden. Der Countdown verwendet den zuletzt gültigen Spielstand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Farm Together 2 uses save version %@. The required data could not be read safely. The countdown uses the last valid save."
          }
        }
      }
    },
