            "value": "Cancel"
          }
        }
      }
    },
    "Alle Farmen": {
      "comment": "User interface text.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Farmen"
          }
        },
        "en": {
